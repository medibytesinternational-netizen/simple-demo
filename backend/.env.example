# Copy to .env and add an OpenAI key or Hugging Face inference token.
# Without an available provider account the app runs in cached demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Use a Hugging Face Inference Providers token instead of an OpenAI key.
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash:fastest
LLM_PROVIDER=auto
LLM_MODE=auto

# MediBytes Transcription API (server-side only)
MEDIBYTES_API_KEY=
MEDIBYTES_BASE_URL=https://product-production-b091.up.railway.app
MEDIBYTES_COMPANY_ID=1
MEDIBYTES_TIMEOUT_SECONDS=120
# Generate a separate secret and configure MediBytes to send it as the callback Bearer token.
MEDIBYTES_CALLBACK_TOKEN=
DEMO_NOW=2026-10-20T09:00:00
DATABASE_URL=sqlite:///./medibytes.db
