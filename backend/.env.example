# Copy to .env and add a key for live GPT-4o calls.
# Without a key the app runs in cached demo mode and everything still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MODE=auto
DEMO_NOW=2026-10-20T09:00:00
DATABASE_URL=sqlite:///./medibytes.db
# MediBytes transcription pipeline (voice -> OPD note). Key starts with mbk_; never commit it.
MEDIBYTES_API_KEY=
MEDIBYTES_BASE_URL=https://product-production-b091.up.railway.app
MEDIBYTES_COMPANY_ID=1
