# Copy to .env and add a key for live GPT-4o calls.
# Without a key the app runs in cached demo mode and everything still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MODE=auto
DEMO_NOW=2026-10-20T09:00:00
DATABASE_URL=sqlite:///./medibytes.db
# OPD voice notes run the local medibytes/ pipeline (needs OPENAI_API_KEY above and
# pip install -r ../requirements-medibytes.txt). Job files go here:
MEDIBYTES_RUNS_DIR=
