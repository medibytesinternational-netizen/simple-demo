# Required for Product's measured gpt-4.1 validation, context repair and note generation.
OPENAI_API_KEY=

# Required to download google/medasr after accepting its Hugging Face license.
HF_TOKEN=
HF_HOME=./.cache/huggingface

# Pipeline output and persistent job state.
MEDIBYTES_RUNS=./runs
MEDIBYTES_HOST=127.0.0.1
MEDIBYTES_PORT=8000
PORT=8000
MEDIBYTES_MAX_UPLOAD_BYTES=67108864
# Optional for a separately hosted frontend; comma-separated browser origins.
# MEDIBYTES_CORS_ORIGINS=https://app.example.com

# Optional: enables the separate, key-protected HIMS transcription delivery API.
# Leave these unset when using only the browser job API.
MEDIBYTES_API_KEYS=
MEDIBYTES_HIMS_URL=
MEDIBYTES_HIMS_TOKEN=

# Optional diagnostics. This writes model prompts/replies and can include clinical text.
# MEDIBYTES_LLM_TRACE=./runs/llm-trace.jsonl
